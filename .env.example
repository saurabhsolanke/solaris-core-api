# ==============================================================================
# SOLARIS BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Connection (Supabase or PostgreSQL with PostGIS extension enabled)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solaris_db

# Supabase Realtime & Service Client
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.demo_service_role_key_for_solaris_platform_broadcasts

# JWT Secret for multi-tenant authentication verification
JWT_SECRET=solaris-secure-multi-tenant-jwt-signing-secret-key-32chars

# Reverse Geocoding Configuration (OpenStreetMap Nominatim)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SOLARIS-Backend/1.0 (solaris@solanke.internal)
