{
  "info": {
    "_postman_id": "7b084e31-89d1-4db8-8d2b-5e63810f5451",
    "name": "SOLARIS Core API",
    "description": "Complete Postman collection for SOLARIS (Solanke Operations, Leave, Attendance, Route & Intelligence System) Core API.\nIncludes employee punch-in/out, GPS telemetry batch ingestion, route playback, and dwell stopovers.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3OTIxMjA2MjcsImV4cCI6MTgyMzY1NjYyNywic3ViIjoiMzMzMzMzMzMtMzMzMy0zMzMzLTMzMzMtMzMzMzMzMzMzMzMzIiwidGVuYW50X2lkIjoiMTExMTExMTEtMTExMS0xMTExLTExMTEtMTExMTExMTExMTExIiwicm9sZSI6IkVNUExPWUVFIiwiZW1haWwiOiJhZ2VudC5yYWh1bEBzb2xhbmtlLmludGVybmFsIn0.jBK6TRBymjDEJVWyAomciUk9CFnbdgMZbk3-XdeF3VE",
      "type": "string"
    },
    {
      "key": "attendance_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Health & Docs",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Checks server status, process uptime, and Supabase / PostgreSQL database connectivity."
          },
          "response": []
        },
        {
          "name": "OpenAPI / Swagger Spec JSON",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs/json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs",
                "json"
              ]
            },
            "description": "Fetches the full OpenAPI 3.0 specification JSON generated by Fastify Swagger."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Login (Generate JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved token:\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sub\": \"33333333-3333-3333-3333-333333333333\",\n  \"tenant_id\": \"11111111-1111-1111-1111-111111111111\",\n  \"role\": \"EMPLOYEE\",\n  \"email\": \"agent.rahul@solanke.internal\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticates user via email or tenant credentials, issues a signed JWT, logs activity, and automatically saves token into collection variable."
          },
          "response": []
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Returns authenticated user identity and tenant company details using the Bearer JWT."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Attendance",
      "item": [
        {
          "name": "Punch In",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"attendance_id\", jsonData.data.id);",
                  "    console.log(\"Captured attendance_id:\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lat\": 18.5204,\n  \"lng\": 73.8567,\n  \"accuracy\": 15.0,\n  \"timestamp\": \"2026-10-16T08:30:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/punch-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "punch-in"
              ]
            },
            "description": "Records employee punch-in with GPS validation (accuracy <= 100m) and reverse geocoding via OpenStreetMap Nominatim. Saves attendance_id automatically to collection variables upon success."
          },
          "response": []
        },
        {
          "name": "Punch Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attendance_id\": \"{{attendance_id}}\",\n  \"lat\": 18.5300,\n  \"lng\": 73.8650,\n  \"accuracy\": 14.5,\n  \"timestamp\": \"2026-10-16T17:30:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/punch-out",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "punch-out"
              ]
            },
            "description": "Records employee punch-out, calculates total road distance traveled (using PostGIS ST_Length), and reverse-geocodes end destination."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Telemetry Tracking",
      "item": [
        {
          "name": "Batch Telemetry Ingestion (Idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"attendance_id\": \"{{attendance_id}}\",\n  \"pings\": [\n    {\n      \"client_uuid\": \"c1111111-0000-4000-a000-000000000001\",\n      \"lat\": 18.5204,\n      \"lng\": 73.8567,\n      \"accuracy\": 10.0,\n      \"speed\": 15.0,\n      \"recorded_at\": \"2026-10-16T09:00:00.000Z\"\n    },\n    {\n      \"client_uuid\": \"c1111111-0000-4000-a000-000000000002\",\n      \"lat\": 18.5220,\n      \"lng\": 73.8580,\n      \"accuracy\": 12.0,\n      \"speed\": 25.5,\n      \"recorded_at\": \"2026-10-16T09:05:00.000Z\"\n    },\n    {\n      \"client_uuid\": \"c1111111-0000-4000-a000-000000000003\",\n      \"lat\": 18.5250,\n      \"lng\": 73.8610,\n      \"accuracy\": 8.5,\n      \"speed\": 28.0,\n      \"recorded_at\": \"2026-10-16T09:10:00.000Z\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/tracking/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "tracking",
                "batch"
              ]
            },
            "description": "Ingests up to 500 GPS location pings from the mobile app. Uses client_uuid to guarantee idempotency on network retries, rejects GPS drift (accuracy > 30m), and broadcasts live coordinates to Supabase Realtime channel."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Route & Analytics",
      "item": [
        {
          "name": "Get Attendance Route & Stopovers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/attendance/{{attendance_id}}/route",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "{{attendance_id}}",
                "route"
              ]
            },
            "description": "Retrieves the complete route history for an attendance session including total road kilometers, Leaflet-compatible [lat, lng] polyline array, and detected dwell stopovers (>10 min dwell within 50m radius)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Activity & Audit Logs",
      "item": [
        {
          "name": "Get My Activity Logs (Employee — own logs only)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/activity/logs?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "activity", "logs"],
              "query": [
                { "key": "limit",      "value": "20" },
                { "key": "offset",     "value": "0" },
                { "key": "event_type", "value": "LOGIN",          "disabled": true },
                { "key": "from",       "value": "2026-10-01T00:00:00.000Z", "disabled": true },
                { "key": "to",         "value": "2026-10-31T23:59:59.000Z", "disabled": true }
              ]
            },
            "description": "Returns the current user's activity log entries (IP, device, endpoint, event type, timestamp). Employees are automatically scoped to their own records.\n\nSend with EMPLOYEE token."
          },
          "response": []
        },
        {
          "name": "Get All User Activity Logs (Admin — any user)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/activity/logs?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "activity", "logs"],
              "query": [
                { "key": "limit",      "value": "50" },
                { "key": "offset",     "value": "0" },
                { "key": "user_id",    "value": "33333333-3333-3333-3333-333333333333", "disabled": true },
                { "key": "event_type", "value": "LOGIN",          "disabled": true },
                { "key": "from",       "value": "2026-10-01T00:00:00.000Z", "disabled": true },
                { "key": "to",         "value": "2026-10-31T23:59:59.000Z", "disabled": true }
              ]
            },
            "description": "Admin can view activity logs for any user in the same tenant. Optionally filter by user_id, event_type, and date range.\n\nSend with ADMIN token."
          },
          "response": []
        },
        {
          "name": "Get Daily Login Summary (Admin only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{admin_token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/activity/summary?limit=30&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "activity", "summary"],
              "query": [
                { "key": "limit",   "value": "30" },
                { "key": "offset",  "value": "0" },
                { "key": "user_id", "value": "33333333-3333-3333-3333-333333333333", "disabled": true },
                { "key": "from",    "value": "2026-10-01T00:00:00.000Z", "disabled": true },
                { "key": "to",      "value": "2026-10-31T23:59:59.000Z", "disabled": true }
              ]
            },
            "description": "Admin-only: returns per-user, per-day totals for login_count, punch_in_count, punch_out_count, batch_ingest_count, and first/last login timestamps.\n\nSend with ADMIN token."
          },
          "response": []
        }
      ]
    }
  ],
